  ./bin/geoffrey app-prompt --task daily|inbox|follow-up|open-loops|ask|capability-review|recommend-skill|build-skill [--request "..."]
  ./bin/geoffrey app-context --task daily|inbox|follow-up|open-loops|ask|capability-review|recommend-skill
  ./bin/geoffrey app-feedback --rating helpful|adjust --note "..."
  ./bin/geoffrey app-complete-item --section "..." --item "..."
  ./bin/geoffrey app-priority-feedback --assessment right|higher|lower|not-useful [--item "..."] [--missing "..."]
  ./bin/geoffrey app-record-briefing --kind daily|inbox|follow-up|open-loops --text "..."
  ./bin/geoffrey app-sync
  ./bin/geoffrey app-sync-status
  ./bin/geoffrey app-portable-state [--write]
  ./bin/geoffrey app-restore-memory --repository OWNER/REPO --target PATH
  ./bin/geoffrey launch [--memory PATH] [--print-prompt] [--no-sync]
  ./bin/geoffrey chief-of-staff --memory PATH
