app_prompt() {
  task="ask"
  request=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task) task="${2:-}"; shift 2 ;;
      --request) request="${2:-}"; shift 2 ;;
      *) say "Unknown option: $1"; exit 1 ;;
    esac
  done

  case "$task" in
    daily|inbox|follow-up|open-loops) first_win_prompt "$task" ;;
    capability-review)
      cat <<'EOF_CAPABILITY_REVIEW'
Use Geoffrey.

Read CLAUDE.md, memory/user.md, memory/tools.md, memory/chief-of-staff.md,
memory/briefing-feedback.md, memory/projects/, memory/waiting/, and
memory/skills/ where present. Also review the local Geoffrey connector playbook
if it is available.

Act as my chief of staff and capability advisor. Identify no more than three
high-value improvements to how Geoffrey helps me run my business.

The app supplies a prepared private context packet below. Use that packet as
your source of truth; do not ask the owner to locate or paste files.

For each recommendation, use this exact shape:

### Name
**Type:** Build a Geoffrey skill | Connect a business tool | Improve an existing skill
**Why now:** one plain-language sentence tied to my actual work
**First win:** the useful result I would get this week
**What I need to approve:** the smallest necessary permission, account sign-in,
or example

Prefer a small, proven next step. Do not install, connect, publish, send, or
change anything. End with a section titled `### Start here` that names the one
recommendation you would do first and the single button or approval the owner
should see next. Never mention packets, files, internal tools, permissions, or
missing context in the owner-facing answer.
EOF_CAPABILITY_REVIEW
      ;;
    recommend-skill)
      cat <<'EOF_RECOMMEND_SKILL'
Use Geoffrey.

The app supplies a prepared private context packet below. Use that packet as
your source of truth; do not ask the owner to locate or paste files.

Recommend exactly one private Geoffrey skill that would reduce this owner's
load this week. Favor a repeated, real business task over a generic assistant
ability. Do not create the skill yet and do not connect accounts, send,
publish, spend, delete, or change anything.

Use this exact shape:

### Recommended skill
**What it handles:** one plain-language sentence
**Why this one:** one sentence tied to the owner's actual work
**First result:** what the owner would receive the first time they use it
**What it needs:** only the smallest missing detail, example, or existing connection

### Start here
Give the owner one short phrase they can approve to create this skill. Never
mention packets, files, internal tools, permissions, or missing context.
EOF_RECOMMEND_SKILL
      ;;
    build-skill)
      cat <<EOF_BUILD_SKILL
Use Geoffrey.

Read CLAUDE.md, memory/user.md, memory/tools.md, memory/chief-of-staff.md,
memory/briefing-feedback.md, and the existing files in memory/skills/ where
present. The owner has approved creating this private Geoffrey skill:

$request

Create one new Markdown file in memory/skills/. Choose a short, descriptive
kebab-case filename. Do not overwrite an existing skill; improve an existing
skill only when it clearly covers the same repeatable work.

The skill must be concise and include these headings:
- When To Use
- What Geoffrey Needs
- Workflow
- Deliverable
- Approval Boundary
- Improvement Loop

Make it useful for this owner's real business, not a generic template. It may
read, organize, summarize, plan, and draft. It must ask before sending,
publishing, spending, deleting, changing access, or creating automation.

Only change the new or updated memory/skills file and, if useful,
memory/chief-of-staff.md. End with a short explanation of what you created and
the first phrase the owner can use to run it.
EOF_BUILD_SKILL
      ;;
    ask|*)
      cat <<EOF_APP_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md, and memory/briefing-feedback.md if present, and the relevant files in memory/skills before answering.

The owner is asking:
$request

Give a direct, useful answer in plain language. You may read connected information and prepare drafts, summaries, plans, or checklists. Do not send, post, publish, spend, delete, deploy, share access, or create recurring automation without asking for approval first. When something should become a stable preference, project, decision, or skill, explain what you would save and ask for confirmation before changing memory.
EOF_APP_PROMPT
      ;;
  esac
}

app_context() {
  task="daily"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task) task="${2:-}"; shift 2 ;;
      *) say "Unknown option: $1"; return 1 ;;
    esac
  done

  case "$task" in
    daily|inbox|follow-up|open-loops|ask|capability-review|recommend-skill) ;;
    *)
      say "This Geoffrey request does not need connected email or calendar context."
      return 0
      ;;
  esac

  if [ ! -f "$MCP_DIR/bin/briefing-context.js" ]; then
    say "Geoffrey's email and calendar reader is missing. Run Geoffrey update, then try again."
    return 1
  fi

  memory_path="$(remembered_memory_path 2>/dev/null || true)"
  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey memory is not ready yet. Finish setup first."
    return 1
  fi

  emit_memory_file() {
    file="$1"
    label="$2"
    if [ -f "$file" ]; then
      printf '\n--- %s ---\n' "$label"
      sed -n '1,220p' "$file"
    fi
  }

  say "PRIVATE GEOFFREY CONTEXT"
  say "This packet was prepared locally from the owner's private GitHub-backed memory."
  emit_memory_file "$memory_path/CLAUDE.md" "Geoffrey operating rules"
  emit_memory_file "$memory_path/memory/user.md" "Owner context"
  emit_memory_file "$memory_path/memory/tools.md" "Business tools"
  emit_memory_file "$memory_path/memory/chief-of-staff.md" "Chief of staff plan"
  emit_memory_file "$memory_path/memory/briefing-feedback.md" "Briefing feedback"
  emit_memory_file "$memory_path/memory/priority-feedback.md" "Priority feedback"
  emit_memory_file "$memory_path/memory/completed-items.md" "Items the owner has handled"

  for file in "$memory_path"/memory/journal/*.md "$memory_path"/memory/projects/*.md "$memory_path"/memory/waiting/*.md "$memory_path"/memory/skills/*.md; do
    [ -f "$file" ] || continue
    emit_memory_file "$file" "${file#"$memory_path"/}"
  done

  # A capability review needs the owner's durable business context, but it does
  # not need live mailbox or calendar data. Keeping that data out makes the
  # recommendation safer and avoids an unnecessary, expensive fetch.
  if [ "$task" = "capability-review" ] || [ "$task" = "recommend-skill" ]; then
    return 0
  fi

  say ""
  node "$MCP_DIR/bin/briefing-context.js" --task "$task"
}

app_record_briefing() {
  kind="daily"
  text=""
  memory_path="$(remembered_memory_path 2>/dev/null || true)"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --kind) kind="${2:-}"; shift 2 ;;
      --text) text="${2:-}"; shift 2 ;;
      *) say "Unknown option: $1"; return 1 ;;
    esac
  done

  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey memory is not ready yet. Finish setup first."
    return 1
  fi
  if [ -z "${text//[[:space:]]/}" ]; then
    say "There was no Geoffrey result to save."
    return 1
  fi

  archive_dir="$memory_path/memory/briefings"
  mkdir -p "$archive_dir"
  stamp="$(date '+%Y-%m-%d-%H%M%S')"
  file="$archive_dir/${stamp}-${kind}.md"
  {
    printf '# Geoffrey %s\n\n' "$kind"
    printf '_Saved %s_\n\n' "$(date '+%Y-%m-%d %H:%M %Z')"
    printf '%s\n' "$text"
  } > "$file"
  commit_memory_changes "$memory_path" "Save Geoffrey $kind briefing"
  sync_memory_repo "$memory_path" "after Geoffrey $kind briefing"
  say "Saved this Geoffrey result to private memory."
}

app_feedback() {
  rating=""
  note=""
  memory_path="$(remembered_memory_path 2>/dev/null || true)"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --rating) rating="${2:-}"; shift 2 ;;
      --note) note="${2:-}"; shift 2 ;;
      *) say "Unknown option: $1"; exit 1 ;;
    esac
  done

  if [ "$rating" != "helpful" ] && [ "$rating" != "adjust" ]; then
    say "Feedback needs a rating of helpful or adjust."
    return 1
  fi
  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey memory is not ready yet. Finish setup first."
    return 1
  fi

  feedback_file="$memory_path/memory/briefing-feedback.md"
  if [ ! -f "$feedback_file" ]; then
    cat > "$feedback_file" <<'EOF_FEEDBACK'
# Briefing Feedback

This is the owner's direct feedback about Geoffrey's daily briefing. Use it to
improve relevance, length, emphasis, and recurring sections. Treat each note as
a preference to confirm before making it permanent in `memory/user.md`.

EOF_FEEDBACK
  fi

  clean_note="$(printf '%s' "$note" | tr '\r\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')"
  [ -n "$clean_note" ] || clean_note="No additional note."
  printf -- '- %s | %s | %s\n' "$(date '+%Y-%m-%d %H:%M')" "$rating" "$clean_note" >> "$feedback_file"
  commit_memory_changes "$memory_path" "Record Geoffrey briefing feedback"
  sync_memory_repo "$memory_path" "after briefing feedback"
  say "Feedback saved. Geoffrey will use it to improve future briefings."
}

app_complete_item() {
  section=""
  item=""
  memory_path="$(remembered_memory_path 2>/dev/null || true)"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --section) section="${2:-}"; shift 2 ;;
      --item) item="${2:-}"; shift 2 ;;
      *) say "Unknown option: $1"; return 1 ;;
    esac
  done

  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey memory is not ready yet. Finish setup first."
    return 1
  fi
  clean_section="$(printf '%s' "$section" | tr '\r\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')"
  clean_item="$(printf '%s' "$item" | tr '\r\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')"
  if [ -z "$clean_section" ] || [ -z "$clean_item" ]; then
    say "Name the briefing section and item to mark it handled."
    return 1
  fi

  completed_file="$memory_path/memory/completed-items.md"
  if [ ! -f "$completed_file" ]; then
    cat > "$completed_file" <<'EOF_COMPLETED'
# Items Marked Handled

These are items the owner marked handled from a Geoffrey briefing. Do not
surface them again unless fresh evidence shows they need attention.

EOF_COMPLETED
  fi
  printf -- '- %s | %s | %s\n' "$(date '+%Y-%m-%d %H:%M')" "$clean_section" "$clean_item" >> "$completed_file"
  commit_memory_changes "$memory_path" "Mark Geoffrey item handled"
  sync_memory_repo "$memory_path" "after marking Geoffrey item handled"
  say "Marked handled. Geoffrey will avoid resurfacing it without new evidence."
}

app_priority_feedback() {
  assessment=""
  item=""
  missing=""
  memory_path="$(remembered_memory_path 2>/dev/null || true)"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --assessment) assessment="${2:-}"; shift 2 ;;
      --item) item="${2:-}"; shift 2 ;;
      --missing) missing="${2:-}"; shift 2 ;;
      *) say "Unknown option: $1"; exit 1 ;;
    esac
  done

  case "$assessment" in
    right|higher|lower|not-useful) ;;
    *) say "Priority feedback needs an assessment of right, higher, lower, or not-useful."; return 1 ;;
  esac
  if [ -z "$item" ] && [ -z "$missing" ]; then
    say "Name a priority Geoffrey showed or add one it missed."
    return 1
  fi
  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey memory is not ready yet. Finish setup first."
    return 1
  fi

  feedback_file="$memory_path/memory/priority-feedback.md"
  if [ ! -f "$feedback_file" ]; then
    cat > "$feedback_file" <<'EOF_PRIORITY_FEEDBACK'
# Priority Learning

This is the owner's direct feedback about what deserves attention in a daily
briefing. Use it to improve ranking and coverage without treating one rating as
a permanent rule. Confirm a repeated preference before adding it to `memory/user.md`.

EOF_PRIORITY_FEEDBACK
  fi

  clean_item="$(printf '%s' "$item" | tr '\r\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')"
  clean_missing="$(printf '%s' "$missing" | tr '\r\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g')"
  timestamp="$(date '+%Y-%m-%d %H:%M')"
  if [ -n "$clean_item" ]; then
    printf -- '- %s | rated %s | %s\n' "$timestamp" "$assessment" "$clean_item" >> "$feedback_file"
  fi
  if [ -n "$clean_missing" ]; then
    printf -- '- %s | missed priority | %s\n' "$timestamp" "$clean_missing" >> "$feedback_file"
  fi
  commit_memory_changes "$memory_path" "Record Geoffrey priority feedback"
  sync_memory_repo "$memory_path" "after priority feedback"
  say "Priority feedback saved. Geoffrey will use it in future briefings."
}

app_sync() {
  memory_path="$(remembered_memory_path 2>/dev/null || true)"
  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey memory is not ready yet. Finish setup first."
    return 1
  fi
  node "$MCP_DIR/bin/memory-sync.js" --phase "after Geoffrey app change"
}

app_sync_status() {
  node "$MCP_DIR/bin/memory-sync.js" --status
}

dashboard_line() {
  state="$1"
  label="$2"
  detail="$3"
  say "$state  $label"
  say "    $detail"
}

dashboard() {
  say "Geoffrey setup dashboard"
  say ""

  ready=0
  total=9

  if command -v claude >/dev/null 2>&1; then
    dashboard_line "OK" "Claude Code" "Ready to run Geoffrey from Terminal."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Claude Code" "Run ./bin/geoffrey bootstrap so Geoffrey can install or repair it."
  fi

  if [ -d "$MCP_DIR/node_modules/@modelcontextprotocol" ]; then
    dashboard_line "OK" "Email/calendar connector" "Local connector is installed."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Email/calendar connector" "Run ./bin/geoffrey setup."
  fi

  count="$(connected_mailboxes_count 2>/dev/null || echo 0)"
  if [ "$count" -gt 0 ]; then
    dashboard_line "OK" "Connected email and calendar" "$count account(s) connected. Calendar is read-only through the same Google/Outlook sign-in."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Connected email and calendar" "Run ./bin/geoffrey add-email."
  fi

  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    dashboard_line "OK" "GitHub memory sync" "GitHub CLI is signed in."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "GitHub memory sync" "Run ./bin/geoffrey setup and follow the GitHub sign-in."
  fi

  if remembered="$(remembered_memory_path 2>/dev/null || true)" && [ -n "$remembered" ]; then
    dashboard_line "OK" "Geoffrey memory home" "$remembered"
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Geoffrey memory home" "Run ./bin/geoffrey setup to create the private memory repo."
  fi

  if [ -x "$LAUNCHER_DIR/Geoffrey" ]; then
    dashboard_line "OK" "One-word launch" "Open a new Terminal and type: Geoffrey"
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "One-word launch" "Run ./bin/geoffrey install-launcher."
  fi

  if [ -x "$DESKTOP_BUTTON" ]; then
    dashboard_line "OK" "Desktop button" "Double-click Geoffrey.command on the Desktop."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Desktop button" "Run ./bin/geoffrey install-desktop-button."
  fi

  if geoffrey_app_path >/dev/null 2>&1; then
    dashboard_line "OK" "Geoffrey app" "Open Geoffrey from Applications for the simple daily workspace."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Geoffrey app" "Run ./bin/geoffrey install-mac-app."
  fi

  if [ -f "$UPDATE_PLIST" ]; then
    dashboard_line "OK" "Updates" "Every other week Geoffrey checks for updates and asks before installing."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Updates" "Run ./bin/geoffrey schedule-updates."
  fi

  say ""
  say "Readiness: $ready/$total"
  say ""
  say "Best next action:"
  if ! command -v claude >/dev/null 2>&1; then
    say "./bin/geoffrey bootstrap"
  elif [ -z "${remembered:-}" ]; then
    say "./bin/geoffrey setup"
  elif [ "$count" -eq 0 ]; then
    say "./bin/geoffrey add-email"
  else
    say "./bin/geoffrey first-win"
  fi
}

write_connection_note() {
  memory_path="$1"
  area="$2"
  app="$3"
  next_step="$4"

  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    return 0
  fi

  mkdir -p "$memory_path/memory"
  note="$memory_path/memory/connections.md"
  if [ ! -f "$note" ]; then
    cat > "$note" <<'EOF_NOTE'
# Connection Plan

Use this file to track tools Geoffrey should connect, test, or work around.

| Date | Area | Tool | Next Step | Status |
|---|---|---|---|---|
EOF_NOTE
  fi
  printf '| %s | %s | %s | %s | Needs setup |\n' "$(date +%F)" "$area" "$app" "$next_step" >> "$note"
  commit_memory_changes "$memory_path" "Update Geoffrey connection plan"
}

connector_prompt() {
  area="$1"
  app="$2"
  cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and memory/connections.md if present.

Help me connect or make useful progress with this tool:

- Area: $area
- Tool: $app

First, tell me whether this can be connected directly in the current environment. If it can, walk me through sign-in one step at a time. If it cannot, give me the easiest useful workaround: export, paste, screenshot, shared folder, downloaded report, or manual browser step.

After setup or workaround, update memory/tools.md and memory/connections.md with the status, what worked, what still needs sign-in, and the safest first task Geoffrey can do with this tool.
EOF_PROMPT
}

connect_tool() {
  memory_path=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --memory)
        memory_path="${2:-}"
        shift 2
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$memory_path" ]; then
    memory_path="$(remembered_memory_path || true)"
  fi

  say "What should Geoffrey connect or set up next?"
  say "1. Email or calendar"
  say "2. Files or documents"
  say "3. Tasks or projects"
  say "4. CRM or clients"
  say "5. Chat or meetings"
  say "6. Money or billing"
  say "7. Website, marketing, or socials"
  say "8. AI or automation"
  choice="$(ask "Choose 1-8" "1")"

  case "$choice" in
    1)
      say "Email and calendar use the same Gmail/Outlook sign-in. Calendar is read-only for safety."
      add_email
      return 0
      ;;
    2) area="Files/docs" ;;
    3) area="Tasks/projects" ;;
    4) area="CRM/clients" ;;
    5) area="Chat/meetings" ;;
    6) area="Money/billing" ;;
    7) area="Website/marketing/socials" ;;
    8) area="AI/automation" ;;
    *) area="Other" ;;
  esac

  app="$(ask "Which app or tool? Example: Google Drive, Slack, HubSpot, QuickBooks, LinkedIn" "")"
  if [ -z "$app" ]; then
    say "No app entered. Nothing changed."
    return 0
  fi

  next_step="Geoffrey should guide sign-in, plugin connection, export, or the easiest safe workaround."
  write_connection_note "$memory_path" "$area" "$app" "$next_step"

  prompt="$(connector_prompt "$area" "$app")"
  if [ -n "$memory_path" ] && [ -d "$memory_path/memory" ]; then
    run_claude_session "$memory_path" "$prompt" "yes" || true
  else
    say ""
    say "Open Geoffrey and paste this:"
    say ""
    printf '%s\n' "$prompt"
  fi
}

packet() {
  name=""
  business="Personal"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --business)
        business="${2:-}"
        shift 2
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$name" ]; then
    say "packet requires --name."
    exit 1
  fi

  mkdir -p "$ROOT/onboarding/recipients"
  slug="$(slugify "$name")"
  target="$ROOT/onboarding/recipients/$slug.md"

  if [ -e "$target" ]; then
    say "Packet already exists: $target"
    exit 0
  fi

  cp "$ROOT/onboarding/recipient-packet-template.md" "$target"
  sed -i.bak \
    -e "s/^# Geoffrey Recipient Packet/# Geoffrey Recipient Packet: $name/" \
    -e "s/^- Name:$/- Name: $name/" \
    -e "s/^- Business\\/team:$/- Business\\/team: $business/" \
    "$target"
  rm -f "$target.bak"
  say "Created packet: $target"
}

share() {
  say "Geoffrey friend handoff"
  say ""
  say "They do not need a GitHub account to download Geoffrey."
  say ""
  say ""
  say "Friend terminal command:"
  say "/bin/bash -c \"\$(curl -fsSL $INSTALLER_URL)\""
  say ""
  say "This public installer clones Geoffrey into ~/Geoffrey, then Geoffrey installs/checks Homebrew, Node.js, Claude Code, and the local email connector."
  say ""
  say "Future updates:"
  say "cd ~/Geoffrey && ./bin/geoffrey update"
  say ""
  say "Daily use after setup:"
  say "Double-click Geoffrey.command on the Desktop, or open Terminal and type: Geoffrey"
  say ""
  say "First proof of value:"
  say "cd ~/Geoffrey && ./bin/geoffrey first-win"
  say ""
  say "GitHub happens during onboarding. Geoffrey will help them create/sign into GitHub because memory lives in a private repo."
  say ""
  say "Zip fallback:"
  say "Use the Geoffrey zip if you are sharing by file instead of Terminal."
}

update_geoffrey() {
  say "Geoffrey update"
  say ""

  if [ ! -d "$ROOT/.git" ]; then
    say "This Geoffrey folder is not a Git checkout."
    say "For future updates, reinstall with:"
    say "/bin/bash -c \"\$(curl -fsSL $INSTALLER_URL)\""
    say ""
    say "Your private accounts live in $STORE_DIR and your memory repo lives outside this folder, so reinstalling Geoffrey does not delete them."
    return 1
  fi

  if ! command -v git >/dev/null 2>&1; then
    say "Git is required to update Geoffrey."
    return 1
  fi

  branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    branch="main"
  fi

  say "Checking for Geoffrey updates..."
  git -C "$ROOT" fetch origin "$branch"

  local_changes="$(git -C "$ROOT" status --porcelain)"
  if [ -n "$local_changes" ]; then
    say "This Geoffrey folder has local changes, so I will not overwrite it automatically."
    say "Ask the person who shared Geoffrey with you, or run git status in:"
    say "$ROOT"
    return 1
  fi

  before="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  git -C "$ROOT" pull --ff-only origin "$branch"
  after="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"

  ensure_node_deps || true
  register_mcp
  schedule_update_checks || true
  install_launcher || true
  install_mac_app || true

  say ""
  if [ "$before" = "$after" ]; then
    say "Geoffrey was already up to date at $after."
  else
    say "Updated Geoffrey: $before -> $after"
  fi
  say ""
  say "Your private account tokens and memory repo were not overwritten."
  say "Run ./bin/geoffrey status to check the setup."
}

open_update_terminal() {
  quoted_root="$(shell_quote "$ROOT")"
  cmd="cd $quoted_root && ./bin/geoffrey update"
  escaped_cmd="$(printf '%s' "$cmd" | applescript_escape)"

  if command -v osascript >/dev/null 2>&1; then
    osascript <<OSA >/dev/null 2>&1 || {
tell application "Terminal"
  activate
  do script "$escaped_cmd"
end tell
OSA
      say "Run this to update Geoffrey:"
      say "$cmd"
    }
  else
    say "Run this to update Geoffrey:"
    say "$cmd"
  fi
}

update_check() {
  quiet="no"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --quiet)
        quiet="yes"
        shift
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ ! -d "$ROOT/.git" ]; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check skipped: this folder is not connected to GitHub."
      say "To move to the update-ready install, run:"
      say "/bin/bash -c \"\$(curl -fsSL $INSTALLER_URL)\""
    fi
    return 0
  fi

  if ! command -v git >/dev/null 2>&1; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check skipped: Git is not installed yet."
    fi
    return 0
  fi

  branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    branch="main"
  fi

  if ! git -C "$ROOT" fetch origin "$branch" >/dev/null 2>&1; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check could not reach GitHub right now."
    fi
    return 0
  fi

  local_rev="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
  remote_rev="$(git -C "$ROOT" rev-parse "origin/$branch" 2>/dev/null || true)"
  if [ -z "$local_rev" ] || [ -z "$remote_rev" ]; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check could not compare versions yet."
    fi
    return 0
  fi

  if [ "$local_rev" = "$remote_rev" ]; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey is already up to date."
    fi
    return 0
  fi

  if ! git -C "$ROOT" merge-base --is-ancestor "$local_rev" "$remote_rev" >/dev/null 2>&1; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check found a different Git history and will not auto-prompt."
      say "Ask the person who shared Geoffrey with you to review this folder:"
      say "$ROOT"
    fi
    return 0
  fi

  short_local="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || printf '%s' "${local_rev:0:7}")"
  short_remote="$(git -C "$ROOT" rev-parse --short "origin/$branch" 2>/dev/null || printf '%s' "${remote_rev:0:7}")"
  message="A Geoffrey update is available.

Current: $short_local
Latest: $short_remote

Install it now?"

  if [ "${GEOFFREY_UPDATE_CHECK_NO_DIALOG:-}" = "1" ] || ! command -v osascript >/dev/null 2>&1; then
    say "$message"
    say ""
    say "Run this when ready:"
    say "cd \"$ROOT\" && ./bin/geoffrey update"
    return 0
  fi

  escaped_message="$(printf '%s' "$message" | applescript_escape)"
  button="$(osascript <<OSA 2>/dev/null || true
button returned of (display dialog "$escaped_message" buttons {"Later", "Install"} default button "Install" with title "Geoffrey Update")
OSA
)"

  if [ "$button" = "Install" ]; then
    open_update_terminal
  else
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update postponed."
    fi
  fi
}

schedule_update_checks() {
  if [ "$(uname -s)" != "Darwin" ]; then
    say "Skipping biweekly update scheduler: automatic prompts are currently Mac-only."
    return 0
  fi

  if [ ! -d "$ROOT/.git" ]; then
    say "Skipping biweekly update scheduler: this Geoffrey folder is not connected to GitHub."
    return 0
  fi

  mkdir -p "$(dirname "$UPDATE_PLIST")" "$STORE_DIR"

  program_arg="$(printf '%s' "$ROOT/bin/geoffrey" | xml_escape)"
  stdout_path="$(printf '%s' "$STORE_DIR/update-check.log" | xml_escape)"
  stderr_path="$(printf '%s' "$STORE_DIR/update-check.err" | xml_escape)"

  cat > "$UPDATE_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$UPDATE_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$program_arg</string>
    <string>update-check</string>
    <string>--quiet</string>
  </array>
  <key>StartInterval</key>
  <integer>$UPDATE_INTERVAL_SECONDS</integer>
  <key>StandardOutPath</key>
  <string>$stdout_path</string>
  <key>StandardErrorPath</key>
  <string>$stderr_path</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
PLIST

  if command -v plutil >/dev/null 2>&1; then
    plutil -lint "$UPDATE_PLIST" >/dev/null
  fi

  if [ "${GEOFFREY_SKIP_LAUNCHCTL:-}" = "1" ]; then
    say "OK  Biweekly Geoffrey update check file written"
    return 0
  fi

  if command -v launchctl >/dev/null 2>&1; then
    launchctl bootout "gui/$(id -u)" "$UPDATE_PLIST" >/dev/null 2>&1 || true
    if launchctl bootstrap "gui/$(id -u)" "$UPDATE_PLIST" >/dev/null 2>&1; then
      say "OK  Biweekly Geoffrey update check scheduled"
      return 0
    fi

    launchctl unload "$UPDATE_PLIST" >/dev/null 2>&1 || true
    if launchctl load "$UPDATE_PLIST" >/dev/null 2>&1; then
      say "OK  Biweekly Geoffrey update check scheduled"
      return 0
    fi
  fi

  say "NOTE  Geoffrey wrote the biweekly update check, but macOS did not load it automatically."
  say "You can still check manually with ./bin/geoffrey update-check"
  return 0
}

doctor() {
  fail=0
  say "Geoffrey package check"
  say "Root: $ROOT"
  say ""

  for path in \
    "$ROOT/README.md" \
    "$ROOT/START_HERE.md" \
    "$ROOT/HANDOFF.md" \
    "$ROOT/CLAUDE.md" \
    "$ROOT/bin/geoffrey" \
    "$ROOT/Install Geoffrey.command" \
    "$ROOT/docs/friend-setup.md" \
    "$ROOT/docs/terminal-bootstrap.md" \
    "$ROOT/docs/friend-test-script.md" \
    "$ROOT/docs/chief-of-staff-tools.md" \
    "$ROOT/docs/connector-playbook.md" \
    "$ROOT/docs/first-use-demo.md" \
    "$ROOT/docs/github-memory-setup.md" \
    "$ROOT/docs/white-glove-walkthrough.md" \
    "$ROOT/docs/multi-email-setup.md" \
    "$ROOT/docs/outlook-setup.md" \
    "$ROOT/dist/Geoffrey-Claude-Plugin.zip" \
    "$ROOT/geoffrey-mcp/src/index.js" \
    "$ROOT/geoffrey-mcp/bin/add-account.js" \
    "$ROOT/memory-template/CLAUDE.md" \
    "$ROOT/memory-template/memory/README.md" \
    "$ROOT/onboarding/recipient-packet-template.md"; do
    if [ -e "$path" ]; then
      say "OK  ${path#$ROOT/}"
    else
      say "NO  ${path#$ROOT/}"
      fail=1
    fi
  done

  if command -v node >/dev/null 2>&1; then
    say "OK  Node.js $(node --version)"
  else
    say "NO  Node.js not found"
    fail=1
  fi

  if [ -d "$MCP_DIR/node_modules/@modelcontextprotocol" ]; then
    say "OK  email connector dependencies installed"
  else
    say "NOTE  email connector dependencies not installed yet; run ./bin/geoffrey setup"
  fi

  ensure_store
  say "OK  private Geoffrey account folder: $STORE_DIR"

  if [ -f "$MCP_DIR/config/microsoft-oauth.json" ]; then
    say "OK  bundled Microsoft OAuth config present"
  else
    say "NOTE  bundled Microsoft OAuth config missing; owner fallback is docs/outlook-setup.md"
  fi

  if [ -f "$GMAIL_OAUTH_FILE" ]; then
    say "OK  bundled Gmail OAuth config present"
  elif [ -f "$GMAIL_OAUTH_BUNDLE_FILE" ]; then
    say "OK  Gmail sign-in helper bundle present"
  elif [ -n "$GMAIL_OAUTH_URL" ]; then
    say "OK  Gmail helper URL configured"
  else
    say "NOTE  Gmail helper missing; Gmail uses Google Desktop OAuth JSON fallback"
  fi

  if command -v gh >/dev/null 2>&1; then
    say "OK  GitHub CLI $(gh --version | head -n 1)"
  else
    say "NOTE  GitHub CLI not found; memory repo can still be created locally."
  fi

  if [ -f "$UPDATE_PLIST" ]; then
    say "OK  biweekly update LaunchAgent present"
  else
    say "NOTE  biweekly update LaunchAgent not installed yet"
  fi

  if [ -x "$LAUNCHER_DIR/Geoffrey" ]; then
    say "OK  one-word Geoffrey launcher present"
  else
    say "NOTE  one-word Geoffrey launcher not installed yet"
  fi

  if [ -x "$DESKTOP_BUTTON" ]; then
    say "OK  Desktop Geoffrey button present"
  else
    say "NOTE  Desktop Geoffrey button not installed yet"
  fi

  say ""
  if [ "$fail" -eq 0 ]; then
    say "Geoffrey package is ready."
  else
    say "Geoffrey package needs attention."
  fi
  exit "$fail"
}

bootstrap() {
  say "Geoffrey terminal bootstrap"
  say ""
  say "This checks the basics, installs what Geoffrey can install safely, then starts the white-glove setup."
  say ""

  ensure_git || true

  ensure_node_runtime || true

  ensure_node_deps || true
  ensure_claude_code || true
  ensure_github_account_ready || true
  ensure_github_cli || true
  register_mcp
  schedule_update_checks || true
  install_launcher || true
  install_mac_app || true

  say ""
  say "Core setup check:"
  status_report
  say ""

  if yes_no "Continue into Geoffrey white-glove setup now? yes/no" "yes"; then
    setup
  else
    say "Paused. Continue later with:"
    say "./bin/geoffrey setup"
  fi
}

setup() {
  say "Welcome to Geoffrey."
  say ""
  say "This setup prepares Geoffrey, explains the white-glove walkthrough, and can connect multiple email/calendar accounts."
  say ""

  ensure_store
  ensure_node_deps || true
  register_mcp
  schedule_update_checks || true
  install_launcher || true
  install_mac_app || true

  say ""
  say "Current Geoffrey mailboxes:"
  list_email || true
  say ""

  connect_now="$(ask "Connect an email account now? yes/no" "yes")"
  case "$connect_now" in
    y|yes|Y|YES) add_email ;;
    *) say "Skipping email connection. Run ./bin/geoffrey add-email when ready." ;;
  esac

  say ""
  say "Now Geoffrey will create your private GitHub-backed memory."
  say "This is Geoffrey's brain: preferences, projects, people, tools, decisions, and open loops."
  say "If you do not have a GitHub account yet, create a free one when Geoffrey opens GitHub sign-in."
  memory_repo

  say ""
  start_prompt
  say ""
  say "Your email connection and private memory are ready."
  say "Your first useful action is waiting in Geoffrey: choose Brief me."
  say "Installation is complete. Open Geoffrey from Applications when you are ready to start with Brief me."
}

