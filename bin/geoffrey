write_skill_file() {
  path="$1"
  title="$2"
  trigger="$3"
  tools="$4"
  output="$5"
  cat > "$path" <<EOF_SKILL
# $title

## When To Use

$trigger

## Tools And Inputs

$tools

## Work Loop

1. State the desired outcome.
2. Gather only the context needed.
3. Produce the smallest useful result.
4. Mark what needs approval.
5. Update memory with durable facts, decisions, or waiting items.

## Output

$output

## Approval Boundary

Geoffrey may read, summarize, organize, and draft. Geoffrey must ask before
sending, posting, publishing, spending, deleting, deploying, sharing access, or
creating recurring automations.
EOF_SKILL
}

write_skill_file_if_missing() {
  path="$1"
  title="$2"
  trigger="$3"
  tools="$4"
  output="$5"
  if [ ! -f "$path" ]; then
    write_skill_file "$path" "$title" "$trigger" "$tools" "$output"
  fi
}

record_memory_path() {
  memory_path="$1"
  ensure_store
  printf '%s\n' "$memory_path" > "$CURRENT_MEMORY_FILE"
  chmod 600 "$CURRENT_MEMORY_FILE" || true
}

remembered_memory_path() {
  if [ -f "$CURRENT_MEMORY_FILE" ]; then
    path="$(sed -n '1p' "$CURRENT_MEMORY_FILE")"
    if [ -n "$path" ] && [ -d "$path/memory" ]; then
      printf '%s\n' "$path"
      return 0
    fi
  fi

  candidate="$(find "$HOME/Repos" -maxdepth 2 -type d -name memory 2>/dev/null \
    | sed 's#/memory$##' \
    | grep '/geoffrey-' \
    | head -n 1 || true)"
  if [ -n "$candidate" ] && [ -d "$candidate/memory" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

commit_memory_changes() {
  memory_path="$1"
  message="$2"

  if [ ! -d "$memory_path/.git" ] || ! command -v git >/dev/null 2>&1; then
    return 0
  fi

  if [ -n "$(git -C "$memory_path" status --porcelain 2>/dev/null || true)" ]; then
    git -C "$memory_path" add .
    git -C "$memory_path" commit -m "$message" >/dev/null || true
  fi
}

sync_memory_repo() {
  memory_path="$1"
  phase="$2"

  if [ ! -d "$memory_path/.git" ] || ! command -v git >/dev/null 2>&1; then
    return 0
  fi

  commit_memory_changes "$memory_path" "Update Geoffrey memory"

  if git -C "$memory_path" remote get-url origin >/dev/null 2>&1; then
    say "Syncing Geoffrey memory with GitHub ($phase)..."
    git -C "$memory_path" pull --rebase --autostash >/dev/null 2>&1 || {
      say "NOTE  Geoffrey could not pull memory updates automatically."
      say "Continue anyway, then ask Geoffrey to review Git sync."
      return 0
    }
    git -C "$memory_path" push >/dev/null 2>&1 || {
      say "NOTE  Geoffrey could not push memory updates automatically."
      say "Continue anyway, then ask Geoffrey to review Git sync."
      return 0
    }
  fi
}

ensure_launch_memory_files() {
  memory_path="$1"
  mkdir -p "$memory_path/memory/skills"

  if [ ! -f "$memory_path/memory/chief-of-staff.md" ]; then
    cat > "$memory_path/memory/chief-of-staff.md" <<'EOF_COS'
# Chief Of Staff Operating Map

## Operating Rhythm

| Rhythm | Purpose | Default Output |
|---|---|---|
| Daily briefing | Start the day with priorities, schedule, open loops, and risks | concise plan for today |
| Inbox rescue | Find important unanswered work across inboxes | urgency list plus draft replies |
| Follow-up sweep | Find people waiting, stalled deals, proposals, and unanswered questions | follow-up list plus drafts |
| Weekly review | Summarize wins, stuck items, money/client risks, and next week | owner-ready review |
| Skill improvement | Turn repeated work into a reusable Geoffrey skill | updated memory/skills files |

## Authority Boundaries

- Retrieve/read: OK when connected.
- Draft/summarize/organize: OK.
- Notify/send/post/share/publish/deploy/spend/delete: ask every time.
- Money, legal, HR, public channels, and recurring automation: explicit approval required.
EOF_COS
  fi

  write_skill_file_if_missing \
    "$memory_path/memory/skills/inbox-rescue.md" \
    "Inbox Rescue" \
    "Use when the owner wants Geoffrey to find important email, unanswered messages, client/prospect/billing/scheduling items, or hidden open loops." \
    "Connected Gmail/Outlook accounts, recent messages, calendar context if available, and known customer/project names." \
    "Urgency groups, top three draft replies, owner decisions needed, and a realistic plan for the rest."

  write_skill_file_if_missing \
    "$memory_path/memory/skills/daily-briefing.md" \
    "Daily Briefing" \
    "Use at the start of a day or when the owner asks what to focus on." \
    "Calendar, email, project/task tools, waiting items, and current memory projects." \
    "A short owner-ready briefing: meetings, priorities, risks, follow-ups, and suggested focus blocks."

  write_skill_file_if_missing \
    "$memory_path/memory/skills/follow-up-finder.md" \
    "Client Follow-Up Finder" \
    "Use when the owner wants stalled deals, client questions, proposals, or waiting replies surfaced." \
    "Email, CRM, project tools, and waiting items." \
    "A ranked follow-up list with draft messages and the reason each item matters."

  write_skill_file_if_missing \
    "$memory_path/memory/skills/skill-builder.md" \
    "Skill Builder" \
    "Use after Geoffrey completes repeated work twice or when the owner says a workflow should become repeatable." \
    "The finished work, examples, tools touched, approval boundaries, and the owner correction history." \
    "A new or updated memory/skills file with trigger, tools, work loop, output, and approval boundary."

  commit_memory_changes "$memory_path" "Refresh Geoffrey launcher skills"
}

launcher_prompt() {
  mailboxes="$(mailbox_summary 2>/dev/null || printf 'unknown')"
  cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and every file in memory/skills.

Start this session as my chief of staff:

1. Run Daily Briefing.
2. Check connected email skills and mailbox context. Connected mailboxes: $mailboxes.
3. Surface today's priorities, calendar risks, waiting items, and important email follow-ups.
4. Draft replies or next actions where useful, but do not send, post, publish, spend, delete, deploy, share access, or create recurring automations without asking.
5. If I have added new preferences, tools, projects, or skills, update the relevant memory files and commit the change.

Keep it practical. Start with the briefing, then ask what I want Geoffrey to handle first.
EOF_PROMPT
}

first_win_prompt() {
  task="$1"
  mailboxes="$(mailbox_summary 2>/dev/null || printf 'unknown')"

  case "$task" in
    daily)
      cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and every file in memory/skills.

Run Daily Briefing now.

Use connected email and calendar accounts where available. Connected mailboxes and calendars come through: $mailboxes.

Give me:
1. Today's schedule and calendar risks.
2. The top priorities I should focus on.
3. Important email follow-ups or waiting items.
4. Suggested focus blocks.
5. The first action Geoffrey can take for me next.

Do not send, post, publish, spend, delete, deploy, share access, or create recurring automations without asking.
EOF_PROMPT
      ;;
    follow-up)
      cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and memory/skills/follow-up-finder.md.

Run Client Follow-Up Finder now.

Use every connected mailbox you can see. Connected mailboxes: $mailboxes.

Look for people waiting on me, stalled client or prospect conversations, proposals, billing questions, scheduling loose ends, and unanswered questions. Return a ranked follow-up list with draft replies for the top three. Do not send anything.
EOF_PROMPT
      ;;
    open-loops)
      cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and every file in memory/skills.

Build my Open Loops list now.

Use connected email/calendar if available. Connected mailboxes: $mailboxes.

Find commitments, waiting items, decisions needed, calendar risks, and next actions. Group them into Today, This Week, Waiting On Someone Else, and Needs Clarification. Do not change outside systems without asking.
EOF_PROMPT
      ;;
    inbox|*)
      cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and memory/skills/inbox-rescue.md.

Run Inbox Rescue now.

Use every connected mailbox you can see. Connected mailboxes: $mailboxes.

Look at the last 7 days. Find important or unanswered client, prospect, billing, or scheduling messages. Group them by urgency, draft replies for the top 3, and suggest a realistic plan for handling the rest today. Do not send anything.
EOF_PROMPT
      ;;
  esac
}

run_claude_session() {
  memory_path="$1"
  prompt="$2"
  sync="${3:-yes}"

  if ! command -v claude >/dev/null 2>&1; then
    say "Claude Code is not installed or is not available in this Terminal."
    say "Run this once:"
    say "cd ~/Geoffrey && ./bin/geoffrey bootstrap"
    say ""
    say "When Claude Code is ready, paste this prompt from the memory repo:"
    say ""
    printf '%s\n' "$prompt"
    return 1
  fi

  if [ "$sync" = "yes" ]; then
    sync_memory_repo "$memory_path" "before launch"
  fi

  say "Opening Claude Code in:"
  say "$memory_path"
  say ""

  set +e
  (cd "$memory_path" && claude --name Geoffrey "$prompt")
  status="$?"
  set -e

  if [ "$sync" = "yes" ]; then
    sync_memory_repo "$memory_path" "after launch"
  fi

  return "$status"
}

install_launcher() {
  ensure_store
  mkdir -p "$LAUNCHER_DIR"

  for old_name in Jeffrey jeffrey; do
    old_path="$LAUNCHER_DIR/$old_name"
    if [ -e "$old_path" ] && grep -q 'GEOFFREY_HOME' "$old_path" 2>/dev/null; then
      rm -f "$old_path"
    fi
  done

  cat > "$LAUNCHER_DIR/Geoffrey" <<'EOF_LAUNCHER'
#!/usr/bin/env bash
set -euo pipefail
GEOFFREY_HOME="${GEOFFREY_HOME:-$HOME/Geoffrey}"
if [ ! -x "$GEOFFREY_HOME/bin/geoffrey" ]; then
  printf '%s\n' "Geoffrey was not found at $GEOFFREY_HOME."
  printf '%s\n' "Run the installer again:"
  printf '%s\n' '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/hammbino/Geoffrey_Installer/main/install.sh)"'
  exit 1
fi
exec "$GEOFFREY_HOME/bin/geoffrey" launch "$@"
EOF_LAUNCHER
  chmod +x "$LAUNCHER_DIR/Geoffrey"

  for name in geoffrey; do
    alias_path="$LAUNCHER_DIR/$name"
    if [ "$LAUNCHER_DIR/Geoffrey" -ef "$alias_path" ] 2>/dev/null; then
      continue
    fi
    ln -sf "$LAUNCHER_DIR/Geoffrey" "$alias_path"
  done

  path_line='export PATH="$HOME/.geoffrey/bin:$PATH"'
  for profile in "$HOME/.zshrc" "$HOME/.bash_profile"; do
    if [ ! -f "$profile" ]; then
      touch "$profile"
    fi
    if ! grep -Fq "$path_line" "$profile" 2>/dev/null; then
      {
        printf '\n'
        printf '# Geoffrey one-word launcher\n'
        printf '%s\n' "$path_line"
      } >> "$profile"
    fi
  done

  say "OK  One-word launcher installed"
  say "Open a new Terminal and type: Geoffrey"
  install_desktop_button || true
}

install_desktop_button() {
  if [ "$(uname -s)" != "Darwin" ]; then
    say "Skipping Desktop button: double-click launchers are currently Mac-only."
    return 0
  fi

  ensure_store
  mkdir -p "$HOME/Desktop"

  old_button="$HOME/Desktop/Jeffrey.command"
  if [ -e "$old_button" ] && grep -q 'Geoffrey generated desktop launcher\|GEOFFREY_HOME' "$old_button" 2>/dev/null; then
    rm -f "$old_button"
  fi

  if [ -e "$DESKTOP_BUTTON" ] && ! grep -q 'Geoffrey generated desktop launcher' "$DESKTOP_BUTTON" 2>/dev/null; then
    say "NOTE  Desktop already has Geoffrey.command, so I left it alone:"
    say "$DESKTOP_BUTTON"
    return 0
  fi

  cat > "$DESKTOP_BUTTON" <<'EOF_BUTTON'
#!/usr/bin/env bash
# Geoffrey generated desktop launcher
set -euo pipefail

clear 2>/dev/null || true
printf '%s\n\n' "Starting Geoffrey..."

GEOFFREY_HOME="${GEOFFREY_HOME:-$HOME/Geoffrey}"
status=0

if [ -x "$HOME/.geoffrey/bin/Geoffrey" ]; then
  "$HOME/.geoffrey/bin/Geoffrey" || status="$?"
elif [ -x "$GEOFFREY_HOME/bin/geoffrey" ]; then
  "$GEOFFREY_HOME/bin/geoffrey" launch || status="$?"
else
  printf '%s\n' "Geoffrey was not found."
  printf '%s\n' "Run the installer again:"
  printf '%s\n' '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/hammbino/Geoffrey_Installer/main/install.sh)"'
  status=1
fi

if [ "$status" -ne 0 ]; then
  printf '\n%s\n' "Geoffrey stopped before finishing."
fi

if [ -t 0 ]; then
  printf '\n%s' "Press Enter to close this window..."
  read -r _ || true
fi

exit "$status"
EOF_BUTTON

  chmod +x "$DESKTOP_BUTTON"
  say "OK  Desktop button installed: $DESKTOP_BUTTON"
}

launch_geoffrey() {
  memory_path=""
  print_prompt="no"
  sync="yes"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --memory)
        memory_path="${2:-}"
        shift 2
        ;;
      --print-prompt)
        print_prompt="yes"
        shift
        ;;
      --no-sync)
        sync="no"
        shift
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$memory_path" ]; then
    memory_path="$(remembered_memory_path || true)"
  fi

  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey does not know where your memory repo is yet."
    say "Run this once:"
    say "cd ~/Geoffrey && ./bin/geoffrey setup"
    exit 1
  fi

  record_memory_path "$memory_path"
  ensure_launch_memory_files "$memory_path"

  prompt="$(launcher_prompt)"
  if [ "$print_prompt" = "yes" ]; then
    printf '%s\n' "$prompt"
    return 0
  fi

  run_claude_session "$memory_path" "$prompt" "$sync"
}

normalize_first_win_task() {
  case "$1" in
    1|daily|briefing|"daily briefing") printf '%s\n' "daily" ;;
    2|inbox|"inbox rescue") printf '%s\n' "inbox" ;;
    3|follow-up|followup|"follow up"|"follow-up finder") printf '%s\n' "follow-up" ;;
    4|open-loops|openloops|"open loops") printf '%s\n' "open-loops" ;;
    *) printf '%s\n' "inbox" ;;
  esac
}

first_win() {
  memory_path=""
  task=""
  print_prompt="no"
  sync="yes"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --memory)
        memory_path="${2:-}"
        shift 2
        ;;
      --task)
        task="${2:-}"
        shift 2
        ;;
      --print-prompt)
        print_prompt="yes"
        shift
        ;;
      --no-sync)
        sync="no"
        shift
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$memory_path" ]; then
    memory_path="$(remembered_memory_path || true)"
  fi

  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "Geoffrey does not know where your memory repo is yet."
    say "Run this once:"
    say "cd ~/Geoffrey && ./bin/geoffrey setup"
    exit 1
  fi

  if [ -z "$task" ]; then
    say "Pick Geoffrey's first useful action:"
    say "1. Daily Briefing"
    say "2. Inbox Rescue"
    say "3. Client Follow-Up Finder"
    say "4. Open Loops"
    task="$(ask "Choose 1-4" "1")"
  fi
  task="$(normalize_first_win_task "$task")"

  record_memory_path "$memory_path"
  ensure_launch_memory_files "$memory_path"
  prompt="$(first_win_prompt "$task")"

  if [ "$print_prompt" = "yes" ]; then
    printf '%s\n' "$prompt"
    return 0
  fi

  run_claude_session "$memory_path" "$prompt" "$sync"
}

chief_of_staff_setup() {
  memory_path=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --memory)
        memory_path="${2:-}"
        shift 2
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$memory_path" ]; then
    memory_path="$(ask "Path to Geoffrey memory repo" "")"
  fi
  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    say "I need the path to a generated Geoffrey memory repo with a memory/ folder."
    say "Create one first with ./bin/geoffrey memory"
    exit 1
  fi

  say "Geoffrey chief-of-staff setup"
  say "Answer with the tools they actually use. Leave blank if none or unknown."
  say ""

  business="$(ask "What kind of business or role is this for?" "")"
  first_win="$(ask "First win to prove value: inbox, schedule, follow-up, open-loops, leads, content" "inbox")"
  email="$(ask "Email tools" "Gmail/Outlook")"
  calendar="$(ask "Calendar tools" "Google Calendar/Outlook Calendar")"
  files="$(ask "Files/docs tools" "")"
  knowledge="$(ask "Knowledge/wiki tools" "")"
  chat="$(ask "Chat tools" "")"
  projects="$(ask "Projects/tasks tools" "")"
  crm="$(ask "CRM/customer tools" "")"
  money="$(ask "Money/billing tools" "")"
  website="$(ask "Website/content tools" "")"
  socials="$(ask "Marketing/socials tools" "")"
  analytics="$(ask "Analytics/support tools" "")"
  automation="$(ask "AI/automation tools" "")"

  all_tools="$email $calendar $files $knowledge $chat $projects $crm $money $website $socials $analytics $automation"
  plugin_plan="$(plugin_plan_for_tools "$all_tools")"

  mkdir -p "$memory_path/memory/skills"

  cat > "$memory_path/memory/tools.md" <<EOF_TOOLS
# Tools And Applications

Use this as Geoffrey's chief-of-staff map of where work lives.

| Area | Tools | Readiness | Notes |
|---|---|---|---|
| Email | $email | Ready now if connected | Geoffrey can draft, not send |
| Calendar | $calendar | Needs sign-in | Event creation or moving needs approval |
| Files/docs | $files | Needs sign-in or example | Sharing access needs approval |
| Knowledge | $knowledge | Needs sign-in or example | Keep source links |
| Chat | $chat | Needs sign-in or export | Draft messages; ask before posting |
| Projects/tasks | $projects | Needs sign-in or example | Confirm project/list before writing |
| CRM/customers | $crm | Needs sign-in or example | CRM writes need approval |
| Money/billing | $money | Too risky until approved | Never spend, refund, charge, or alter books without approval |
| Website/content | $website | Needs sign-in; approval before publishing/deploying |  |
| Marketing/socials | $socials | Needs sign-in; approval before posting/replying |  |
| Analytics/support | $analytics | Needs sign-in or export | Read-only first |
| AI/automation | $automation | Needs setup; approval before recurring automation |  |

## Plugin And Connector Plan

| Tool | Plugin / Connector | Status | Boundary |
|---|---|---|---|
$plugin_plan

## Core Setup Stack

- [x] Memory/GitHub
- [ ] Email
- [ ] Calendar
- [ ] Files/docs
- [ ] Tasks/projects
- [ ] CRM/customers
- [ ] Money/billing
- [ ] Chat/meetings
- [ ] Website/content
- [ ] Marketing/socials
- [ ] AI/automation

## Readiness Labels

- Ready now
- Needs sign-in
- Needs example
- Needs setup
- Too risky for now

## Next Connection

Choose the next app based on the first useful action and the owner's real stack.
EOF_TOOLS

  cat > "$memory_path/memory/chief-of-staff.md" <<EOF_COS
# Chief Of Staff Operating Map

## Business Context

- Business or role: ${business:-unknown}
- First proof of value: $first_win

## Operating Rhythm

| Rhythm | Purpose | Default Output |
|---|---|---|
| Daily briefing | Start the day with priorities, schedule, open loops, and risks | concise plan for today |
| Inbox rescue | Find important unanswered work across inboxes | urgency list plus draft replies |
| Follow-up sweep | Find people waiting, stalled deals, proposals, and unanswered questions | follow-up list plus drafts |
| Weekly review | Summarize wins, stuck items, money/client risks, and next week | owner-ready review |
| Skill improvement | Turn repeated work into a reusable Geoffrey skill | updated memory/skills files |

## Work Intake

For every new task:

1. Identify the outcome.
2. Identify which tools hold the truth.
3. Retrieve context before writing.
4. Draft or organize the work.
5. Ask before actions with risk.
6. Update memory when a durable preference, decision, person, project, or waiting item changes.

## Authority Boundaries

- Retrieve/read: OK when connected.
- Draft/summarize/organize: OK.
- Write to private working docs/tasks: ask if destination is unclear.
- Notify/send/post/share/publish/deploy/spend/delete: ask every time.
- Money, legal, HR, public channels, and recurring automation: explicit approval required.

## First Real Work Prompt

Read CLAUDE.md, memory/tools.md, and memory/chief-of-staff.md.

Run $first_win as the first proof of value. Use connected tools where available.
If a tool is not connected, ask for the smallest useful export, paste, screenshot,
or sign-in step. Produce a useful result before expanding the system map.
EOF_COS

  write_skill_file \
    "$memory_path/memory/skills/inbox-rescue.md" \
    "Inbox Rescue" \
    "Use when the owner wants Geoffrey to find important email, unanswered messages, client/prospect/billing/scheduling items, or hidden open loops." \
    "Connected Gmail/Outlook accounts, recent messages, calendar context if available, and known customer/project names." \
    "Urgency groups, top three draft replies, owner decisions needed, and a realistic plan for the rest."

  write_skill_file \
    "$memory_path/memory/skills/daily-briefing.md" \
    "Daily Briefing" \
    "Use at the start of a day or when the owner asks what to focus on." \
    "Calendar, email, project/task tools, waiting items, and current memory projects." \
    "A short owner-ready briefing: meetings, priorities, risks, follow-ups, and suggested focus blocks."

  write_skill_file \
    "$memory_path/memory/skills/follow-up-finder.md" \
    "Client Follow-Up Finder" \
    "Use when the owner wants stalled deals, client questions, proposals, or waiting replies surfaced." \
    "Email, CRM, project tools, and waiting items." \
    "A ranked follow-up list with draft messages and the reason each item matters."

  write_skill_file \
    "$memory_path/memory/skills/skill-builder.md" \
    "Skill Builder" \
    "Use after Geoffrey completes repeated work twice or when the owner says a workflow should become repeatable." \
    "The finished work, examples, tools touched, approval boundaries, and the owner correction history." \
    "A new or updated memory/skills file with trigger, tools, work loop, output, and approval boundary."

  if [ -d "$memory_path/.git" ]; then
    git -C "$memory_path" add memory/tools.md memory/chief-of-staff.md memory/skills
    git -C "$memory_path" commit -m "Add Geoffrey chief of staff operating map" >/dev/null || true
  fi
  record_memory_path "$memory_path"
  install_launcher || true

  say ""
  say "Updated Geoffrey chief-of-staff memory:"
  say "- $memory_path/memory/tools.md"
  say "- $memory_path/memory/chief-of-staff.md"
  say "- $memory_path/memory/skills/inbox-rescue.md"
  say "- $memory_path/memory/skills/daily-briefing.md"
  say "- $memory_path/memory/skills/follow-up-finder.md"
  say "- $memory_path/memory/skills/skill-builder.md"
  say ""
  say "Next prompt:"
  say "Open a new Terminal and type: Geoffrey"
  say "Or open $memory_path in Claude Code or Codex and say:"
  say "Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md, and memory/skills/skill-builder.md. Run the daily briefing, then tell me which plugin or connector should be connected next."
}

status_report() {
  say "Geoffrey setup status"
  say ""

  if [ -x "$ROOT/Install Geoffrey.command" ]; then
    say "OK  Mac installer is present"
  else
    say "NO  Mac installer is missing"
  fi

  if command -v node >/dev/null 2>&1; then
    say "OK  Node.js installed"
  else
    say "NO  Node.js missing"
  fi

  if command -v claude >/dev/null 2>&1; then
    say "OK  Claude Code installed"
  else
    say "TODO  Install Claude Code with ./bin/geoffrey bootstrap"
  fi

  if [ -d "$MCP_DIR/node_modules/@modelcontextprotocol" ]; then
    say "OK  Email connector dependencies installed"
  else
    say "TODO  Run ./bin/geoffrey setup to install email connector dependencies"
  fi

  count="$(connected_mailboxes_count 2>/dev/null || echo 0)"
  if [ "$count" -gt 0 ]; then
    say "OK  Connected mailboxes: $count"
    list_email
  else
    say "TODO  Connect at least one mailbox with ./bin/geoffrey add-email"
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      say "OK  GitHub CLI signed in"
    else
      say "TODO  Run gh auth login for GitHub-backed memory"
    fi
  else
    say "TODO  Install GitHub CLI and sign in for Geoffrey memory"
  fi

  if [ -f "$GMAIL_OAUTH_FILE" ]; then
    say "OK  Bundled Gmail OAuth config present"
  elif [ -f "$GMAIL_OAUTH_BUNDLE_FILE" ]; then
    say "OK  Gmail sign-in helper available"
  elif [ -n "$GMAIL_OAUTH_URL" ]; then
    say "OK  Gmail helper URL configured"
  else
    say "NOTE  Bundled Gmail OAuth config missing; Gmail needs a Google Desktop OAuth JSON file"
  fi

  if [ -f "$MCP_DIR/config/microsoft-oauth.json" ]; then
    say "OK  Bundled Microsoft OAuth config present"
  else
    say "TODO  Microsoft sign-in helper missing; owner fallback is docs/outlook-setup.md"
  fi

  if [ -f "$UPDATE_PLIST" ]; then
    say "OK  Biweekly Geoffrey update check scheduled"
  else
    say "TODO  Schedule biweekly update checks with ./bin/geoffrey schedule-updates"
  fi

  if [ -x "$LAUNCHER_DIR/Geoffrey" ]; then
    say "OK  One-word launcher installed: Geoffrey"
  else
    say "TODO  Install one-word launcher with ./bin/geoffrey install-launcher"
  fi

  if [ -x "$DESKTOP_BUTTON" ]; then
    say "OK  Desktop button installed: $DESKTOP_BUTTON"
  else
    say "TODO  Install Desktop button with ./bin/geoffrey install-desktop-button"
  fi

  if remembered="$(remembered_memory_path 2>/dev/null || true)" && [ -n "$remembered" ]; then
    say "OK  Geoffrey memory home: $remembered"
  else
    say "TODO  Create Geoffrey memory with ./bin/geoffrey setup"
  fi

  say ""
  say "Next best action:"
  if [ "$count" -gt 0 ]; then
    say "./bin/geoffrey first-win"
  else
    say "./bin/geoffrey add-email"
  fi
}

dashboard_line() {
  state="$1"
  label="$2"
  detail="$3"
  say "$state  $label"
  say "    $detail"
}

dashboard() {
  say "Geoffrey setup dashboard"
  say ""

  ready=0
  total=8

  if command -v claude >/dev/null 2>&1; then
    dashboard_line "OK" "Claude Code" "Ready to run Geoffrey from Terminal."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Claude Code" "Run ./bin/geoffrey bootstrap so Geoffrey can install or repair it."
  fi

  if [ -d "$MCP_DIR/node_modules/@modelcontextprotocol" ]; then
    dashboard_line "OK" "Email/calendar connector" "Local connector is installed."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Email/calendar connector" "Run ./bin/geoffrey setup."
  fi

  count="$(connected_mailboxes_count 2>/dev/null || echo 0)"
  if [ "$count" -gt 0 ]; then
    dashboard_line "OK" "Connected email and calendar" "$count account(s) connected. Calendar is read-only through the same Google/Outlook sign-in."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Connected email and calendar" "Run ./bin/geoffrey add-email."
  fi

  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    dashboard_line "OK" "GitHub memory sync" "GitHub CLI is signed in."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "GitHub memory sync" "Run ./bin/geoffrey setup and follow the GitHub sign-in."
  fi

  if remembered="$(remembered_memory_path 2>/dev/null || true)" && [ -n "$remembered" ]; then
    dashboard_line "OK" "Geoffrey memory home" "$remembered"
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Geoffrey memory home" "Run ./bin/geoffrey setup to create the private memory repo."
  fi

  if [ -x "$LAUNCHER_DIR/Geoffrey" ]; then
    dashboard_line "OK" "One-word launch" "Open a new Terminal and type: Geoffrey"
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "One-word launch" "Run ./bin/geoffrey install-launcher."
  fi

  if [ -x "$DESKTOP_BUTTON" ]; then
    dashboard_line "OK" "Desktop button" "Double-click Geoffrey.command on the Desktop."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Desktop button" "Run ./bin/geoffrey install-desktop-button."
  fi

  if [ -f "$UPDATE_PLIST" ]; then
    dashboard_line "OK" "Updates" "Every other week Geoffrey checks for updates and asks before installing."
    ready=$((ready + 1))
  else
    dashboard_line "TODO" "Updates" "Run ./bin/geoffrey schedule-updates."
  fi

  say ""
  say "Readiness: $ready/$total"
  say ""
  say "Best next action:"
  if ! command -v claude >/dev/null 2>&1; then
    say "./bin/geoffrey bootstrap"
  elif [ -z "${remembered:-}" ]; then
    say "./bin/geoffrey setup"
  elif [ "$count" -eq 0 ]; then
    say "./bin/geoffrey add-email"
  else
    say "./bin/geoffrey first-win"
  fi
}

write_connection_note() {
  memory_path="$1"
  area="$2"
  app="$3"
  next_step="$4"

  if [ -z "$memory_path" ] || [ ! -d "$memory_path/memory" ]; then
    return 0
  fi

  mkdir -p "$memory_path/memory"
  note="$memory_path/memory/connections.md"
  if [ ! -f "$note" ]; then
    cat > "$note" <<'EOF_NOTE'
# Connection Plan

Use this file to track tools Geoffrey should connect, test, or work around.

| Date | Area | Tool | Next Step | Status |
|---|---|---|---|---|
EOF_NOTE
  fi
  printf '| %s | %s | %s | %s | Needs setup |\n' "$(date +%F)" "$area" "$app" "$next_step" >> "$note"
  commit_memory_changes "$memory_path" "Update Geoffrey connection plan"
}

connector_prompt() {
  area="$1"
  app="$2"
  cat <<EOF_PROMPT
Use Geoffrey.

Read CLAUDE.md, memory/tools.md, memory/chief-of-staff.md if present, and memory/connections.md if present.

Help me connect or make useful progress with this tool:

- Area: $area
- Tool: $app

First, tell me whether this can be connected directly in the current environment. If it can, walk me through sign-in one step at a time. If it cannot, give me the easiest useful workaround: export, paste, screenshot, shared folder, downloaded report, or manual browser step.

After setup or workaround, update memory/tools.md and memory/connections.md with the status, what worked, what still needs sign-in, and the safest first task Geoffrey can do with this tool.
EOF_PROMPT
}

connect_tool() {
  memory_path=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --memory)
        memory_path="${2:-}"
        shift 2
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$memory_path" ]; then
    memory_path="$(remembered_memory_path || true)"
  fi

  say "What should Geoffrey connect or set up next?"
  say "1. Email or calendar"
  say "2. Files or documents"
  say "3. Tasks or projects"
  say "4. CRM or clients"
  say "5. Chat or meetings"
  say "6. Money or billing"
  say "7. Website, marketing, or socials"
  say "8. AI or automation"
  choice="$(ask "Choose 1-8" "1")"

  case "$choice" in
    1)
      say "Email and calendar use the same Gmail/Outlook sign-in. Calendar is read-only for safety."
      add_email
      return 0
      ;;
    2) area="Files/docs" ;;
    3) area="Tasks/projects" ;;
    4) area="CRM/clients" ;;
    5) area="Chat/meetings" ;;
    6) area="Money/billing" ;;
    7) area="Website/marketing/socials" ;;
    8) area="AI/automation" ;;
    *) area="Other" ;;
  esac

  app="$(ask "Which app or tool? Example: Google Drive, Slack, HubSpot, QuickBooks, LinkedIn" "")"
  if [ -z "$app" ]; then
    say "No app entered. Nothing changed."
    return 0
  fi

  next_step="Geoffrey should guide sign-in, plugin connection, export, or the easiest safe workaround."
  write_connection_note "$memory_path" "$area" "$app" "$next_step"

  prompt="$(connector_prompt "$area" "$app")"
  if [ -n "$memory_path" ] && [ -d "$memory_path/memory" ]; then
    run_claude_session "$memory_path" "$prompt" "yes" || true
  else
    say ""
    say "Open Geoffrey and paste this:"
    say ""
    printf '%s\n' "$prompt"
  fi
}

packet() {
  name=""
  business="Personal"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        name="${2:-}"
        shift 2
        ;;
      --business)
        business="${2:-}"
        shift 2
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ -z "$name" ]; then
    say "packet requires --name."
    exit 1
  fi

  mkdir -p "$ROOT/onboarding/recipients"
  slug="$(slugify "$name")"
  target="$ROOT/onboarding/recipients/$slug.md"

  if [ -e "$target" ]; then
    say "Packet already exists: $target"
    exit 0
  fi

  cp "$ROOT/onboarding/recipient-packet-template.md" "$target"
  sed -i.bak \
    -e "s/^# Geoffrey Recipient Packet/# Geoffrey Recipient Packet: $name/" \
    -e "s/^- Name:$/- Name: $name/" \
    -e "s/^- Business\\/team:$/- Business\\/team: $business/" \
    "$target"
  rm -f "$target.bak"
  say "Created packet: $target"
}

share() {
  say "Geoffrey friend handoff"
  say ""
  say "They do not need a GitHub account to download Geoffrey."
  say ""
  say ""
  say "Friend terminal command:"
  say "/bin/bash -c \"\$(curl -fsSL $INSTALLER_URL)\""
  say ""
  say "This public installer clones Geoffrey into ~/Geoffrey, then Geoffrey installs/checks Homebrew, Node.js, Claude Code, and the local email connector."
  say ""
  say "Future updates:"
  say "cd ~/Geoffrey && ./bin/geoffrey update"
  say ""
  say "Daily use after setup:"
  say "Double-click Geoffrey.command on the Desktop, or open Terminal and type: Geoffrey"
  say ""
  say "First proof of value:"
  say "cd ~/Geoffrey && ./bin/geoffrey first-win"
  say ""
  say "GitHub happens during onboarding. Geoffrey will help them create/sign into GitHub because memory lives in a private repo."
  say ""
  say "Zip fallback:"
  say "Use the Geoffrey zip if you are sharing by file instead of Terminal."
}

update_geoffrey() {
  say "Geoffrey update"
  say ""

  if [ ! -d "$ROOT/.git" ]; then
    say "This Geoffrey folder is not a Git checkout."
    say "For future updates, reinstall with:"
    say "/bin/bash -c \"\$(curl -fsSL $INSTALLER_URL)\""
    say ""
    say "Your private accounts live in $STORE_DIR and your memory repo lives outside this folder, so reinstalling Geoffrey does not delete them."
    return 1
  fi

  if ! command -v git >/dev/null 2>&1; then
    say "Git is required to update Geoffrey."
    return 1
  fi

  branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    branch="main"
  fi

  say "Checking for Geoffrey updates..."
  git -C "$ROOT" fetch origin "$branch"

  local_changes="$(git -C "$ROOT" status --porcelain)"
  if [ -n "$local_changes" ]; then
    say "This Geoffrey folder has local changes, so I will not overwrite it automatically."
    say "Ask the person who shared Geoffrey with you, or run git status in:"
    say "$ROOT"
    return 1
  fi

  before="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  git -C "$ROOT" pull --ff-only origin "$branch"
  after="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"

  ensure_node_deps || true
  register_mcp
  schedule_update_checks || true
  install_launcher || true

  say ""
  if [ "$before" = "$after" ]; then
    say "Geoffrey was already up to date at $after."
  else
    say "Updated Geoffrey: $before -> $after"
  fi
  say ""
  say "Your private account tokens and memory repo were not overwritten."
  say "Run ./bin/geoffrey status to check the setup."
}

open_update_terminal() {
  quoted_root="$(shell_quote "$ROOT")"
  cmd="cd $quoted_root && ./bin/geoffrey update"
  escaped_cmd="$(printf '%s' "$cmd" | applescript_escape)"

  if command -v osascript >/dev/null 2>&1; then
    osascript <<OSA >/dev/null 2>&1 || {
tell application "Terminal"
  activate
  do script "$escaped_cmd"
end tell
OSA
      say "Run this to update Geoffrey:"
      say "$cmd"
    }
  else
    say "Run this to update Geoffrey:"
    say "$cmd"
  fi
}

update_check() {
  quiet="no"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --quiet)
        quiet="yes"
        shift
        ;;
      *)
        say "Unknown option: $1"
        usage
        exit 1
        ;;
    esac
  done

  if [ ! -d "$ROOT/.git" ]; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check skipped: this folder is not connected to GitHub."
      say "To move to the update-ready install, run:"
      say "/bin/bash -c \"\$(curl -fsSL $INSTALLER_URL)\""
    fi
    return 0
  fi

  if ! command -v git >/dev/null 2>&1; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check skipped: Git is not installed yet."
    fi
    return 0
  fi

  branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
  if [ -z "$branch" ]; then
    branch="main"
  fi

  if ! git -C "$ROOT" fetch origin "$branch" >/dev/null 2>&1; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check could not reach GitHub right now."
    fi
    return 0
  fi

  local_rev="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
  remote_rev="$(git -C "$ROOT" rev-parse "origin/$branch" 2>/dev/null || true)"
  if [ -z "$local_rev" ] || [ -z "$remote_rev" ]; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check could not compare versions yet."
    fi
    return 0
  fi

  if [ "$local_rev" = "$remote_rev" ]; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey is already up to date."
    fi
    return 0
  fi

  if ! git -C "$ROOT" merge-base --is-ancestor "$local_rev" "$remote_rev" >/dev/null 2>&1; then
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update check found a different Git history and will not auto-prompt."
      say "Ask the person who shared Geoffrey with you to review this folder:"
      say "$ROOT"
    fi
    return 0
  fi

  short_local="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || printf '%s' "${local_rev:0:7}")"
  short_remote="$(git -C "$ROOT" rev-parse --short "origin/$branch" 2>/dev/null || printf '%s' "${remote_rev:0:7}")"
  message="A Geoffrey update is available.

Current: $short_local
Latest: $short_remote

Install it now?"

  if [ "${GEOFFREY_UPDATE_CHECK_NO_DIALOG:-}" = "1" ] || ! command -v osascript >/dev/null 2>&1; then
    say "$message"
    say ""
    say "Run this when ready:"
    say "cd \"$ROOT\" && ./bin/geoffrey update"
    return 0
  fi

  escaped_message="$(printf '%s' "$message" | applescript_escape)"
  button="$(osascript <<OSA 2>/dev/null || true
button returned of (display dialog "$escaped_message" buttons {"Later", "Install"} default button "Install" with title "Geoffrey Update")
OSA
)"

  if [ "$button" = "Install" ]; then
    open_update_terminal
  else
    if [ "$quiet" != "yes" ]; then
      say "Geoffrey update postponed."
    fi
  fi
}

schedule_update_checks() {
  if [ "$(uname -s)" != "Darwin" ]; then
    say "Skipping biweekly update scheduler: automatic prompts are currently Mac-only."
    return 0
  fi

  if [ ! -d "$ROOT/.git" ]; then
    say "Skipping biweekly update scheduler: this Geoffrey folder is not connected to GitHub."
    return 0
  fi

  mkdir -p "$(dirname "$UPDATE_PLIST")" "$STORE_DIR"

  program_arg="$(printf '%s' "$ROOT/bin/geoffrey" | xml_escape)"
  stdout_path="$(printf '%s' "$STORE_DIR/update-check.log" | xml_escape)"
  stderr_path="$(printf '%s' "$STORE_DIR/update-check.err" | xml_escape)"

  cat > "$UPDATE_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$UPDATE_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$program_arg</string>
    <string>update-check</string>
    <string>--quiet</string>
  </array>
  <key>StartInterval</key>
  <integer>$UPDATE_INTERVAL_SECONDS</integer>
  <key>StandardOutPath</key>
  <string>$stdout_path</string>
  <key>StandardErrorPath</key>
  <string>$stderr_path</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
PLIST

  if command -v plutil >/dev/null 2>&1; then
    plutil -lint "$UPDATE_PLIST" >/dev/null
  fi

  if [ "${GEOFFREY_SKIP_LAUNCHCTL:-}" = "1" ]; then
    say "OK  Biweekly Geoffrey update check file written"
    return 0
  fi

  if command -v launchctl >/dev/null 2>&1; then
    launchctl bootout "gui/$(id -u)" "$UPDATE_PLIST" >/dev/null 2>&1 || true
    if launchctl bootstrap "gui/$(id -u)" "$UPDATE_PLIST" >/dev/null 2>&1; then
      say "OK  Biweekly Geoffrey update check scheduled"
      return 0
    fi

    launchctl unload "$UPDATE_PLIST" >/dev/null 2>&1 || true
    if launchctl load "$UPDATE_PLIST" >/dev/null 2>&1; then
      say "OK  Biweekly Geoffrey update check scheduled"
      return 0
    fi
  fi

  say "NOTE  Geoffrey wrote the biweekly update check, but macOS did not load it automatically."
  say "You can still check manually with ./bin/geoffrey update-check"
  return 0
}

doctor() {
  fail=0
  say "Geoffrey package check"
  say "Root: $ROOT"
  say ""

  for path in \
    "$ROOT/README.md" \
    "$ROOT/START_HERE.md" \
    "$ROOT/HANDOFF.md" \
    "$ROOT/CLAUDE.md" \
    "$ROOT/bin/geoffrey" \
    "$ROOT/Install Geoffrey.command" \
    "$ROOT/docs/friend-setup.md" \
    "$ROOT/docs/terminal-bootstrap.md" \
    "$ROOT/docs/friend-test-script.md" \
    "$ROOT/docs/chief-of-staff-tools.md" \
    "$ROOT/docs/connector-playbook.md" \
    "$ROOT/docs/first-use-demo.md" \
    "$ROOT/docs/github-memory-setup.md" \
    "$ROOT/docs/white-glove-walkthrough.md" \
    "$ROOT/docs/multi-email-setup.md" \
    "$ROOT/docs/outlook-setup.md" \
    "$ROOT/dist/Geoffrey-Claude-Plugin.zip" \
    "$ROOT/geoffrey-mcp/src/index.js" \
    "$ROOT/geoffrey-mcp/bin/add-account.js" \
    "$ROOT/memory-template/CLAUDE.md" \
    "$ROOT/memory-template/memory/README.md" \
    "$ROOT/onboarding/recipient-packet-template.md"; do
    if [ -e "$path" ]; then
      say "OK  ${path#$ROOT/}"
    else
      say "NO  ${path#$ROOT/}"
      fail=1
    fi
  done

  if command -v node >/dev/null 2>&1; then
    say "OK  Node.js $(node --version)"
  else
    say "NO  Node.js not found"
    fail=1
  fi

  if [ -d "$MCP_DIR/node_modules/@modelcontextprotocol" ]; then
    say "OK  email connector dependencies installed"
  else
    say "NOTE  email connector dependencies not installed yet; run ./bin/geoffrey setup"
  fi

  ensure_store
  say "OK  private Geoffrey account folder: $STORE_DIR"

  if [ -f "$MCP_DIR/config/microsoft-oauth.json" ]; then
    say "OK  bundled Microsoft OAuth config present"
  else
    say "NOTE  bundled Microsoft OAuth config missing; owner fallback is docs/outlook-setup.md"
  fi

  if [ -f "$GMAIL_OAUTH_FILE" ]; then
    say "OK  bundled Gmail OAuth config present"
  elif [ -f "$GMAIL_OAUTH_BUNDLE_FILE" ]; then
    say "OK  Gmail sign-in helper bundle present"
  elif [ -n "$GMAIL_OAUTH_URL" ]; then
    say "OK  Gmail helper URL configured"
  else
    say "NOTE  Gmail helper missing; Gmail uses Google Desktop OAuth JSON fallback"
  fi

  if command -v gh >/dev/null 2>&1; then
    say "OK  GitHub CLI $(gh --version | head -n 1)"
  else
    say "NOTE  GitHub CLI not found; memory repo can still be created locally."
  fi

  if [ -f "$UPDATE_PLIST" ]; then
    say "OK  biweekly update LaunchAgent present"
  else
    say "NOTE  biweekly update LaunchAgent not installed yet"
  fi

  if [ -x "$LAUNCHER_DIR/Geoffrey" ]; then
    say "OK  one-word Geoffrey launcher present"
  else
    say "NOTE  one-word Geoffrey launcher not installed yet"
  fi

  if [ -x "$DESKTOP_BUTTON" ]; then
    say "OK  Desktop Geoffrey button present"
  else
    say "NOTE  Desktop Geoffrey button not installed yet"
  fi

  say ""
  if [ "$fail" -eq 0 ]; then
    say "Geoffrey package is ready."
  else
    say "Geoffrey package needs attention."
  fi
  exit "$fail"
}

bootstrap() {
  say "Geoffrey terminal bootstrap"
  say ""
  say "This checks the basics, installs what Geoffrey can install safely, then starts the white-glove setup."
  say ""

  ensure_git || true

  ensure_node_runtime || true

  ensure_node_deps || true
  ensure_claude_code || true
  ensure_github_account_ready || true
  ensure_github_cli || true
  register_mcp
  schedule_update_checks || true
  install_launcher || true

  say ""
  say "Core setup check:"
  status_report
  say ""

  if yes_no "Continue into Geoffrey white-glove setup now? yes/no" "yes"; then
    setup
  else
    say "Paused. Continue later with:"
    say "./bin/geoffrey setup"
  fi
}

setup() {
  say "Welcome to Geoffrey."
  say ""
  say "This setup prepares Geoffrey, explains the white-glove walkthrough, and can connect multiple email/calendar accounts."
  say ""

  ensure_store
  ensure_node_deps || true
  register_mcp
  schedule_update_checks || true
  install_launcher || true

  say ""
  say "Current Geoffrey mailboxes:"
  list_email || true
  say ""

  connect_now="$(ask "Connect an email account now? yes/no" "yes")"
  case "$connect_now" in
    y|yes|Y|YES) add_email ;;
    *) say "Skipping email connection. Run ./bin/geoffrey add-email when ready." ;;
  esac

  say ""
  say "Now Geoffrey will create your private GitHub-backed memory."
  say "This is Geoffrey's brain: preferences, projects, people, tools, decisions, and open loops."
  say "If you do not have a GitHub account yet, create a free one when Geoffrey opens GitHub sign-in."
  memory_repo

  say ""
  start_prompt
  say ""
  dashboard
  say ""
  say "Daily use:"
  say "Double-click Geoffrey.command on the Desktop, or open Terminal and type: Geoffrey"
  say ""
  say "To finish mapping the owner's full chief-of-staff system, run:"
  say "./bin/geoffrey chief-of-staff --memory \"$target\""
  say ""
  if yes_no "Run Geoffrey's first useful action now? yes/no" "yes"; then
    first_win --memory "$target" || true
  else
    demo_prompt
  fi
}

case "${1:-}" in
  bootstrap)
    bootstrap
    ;;
  setup)
    setup
    ;;
  start)
    start_prompt
    ;;
  walkthrough)
    walkthrough
    ;;
  apps)
    apps_prompt
    ;;
  connectors)
    connectors_prompt
    ;;
  demo)
    demo_prompt
    ;;
  first-run)
    first_run_prompt
    ;;
  first-win)
    shift
    first_win "$@"
    ;;
  dashboard)
    dashboard
    ;;
  status)
    status_report
    ;;
  connect-tool)
    shift
    connect_tool "$@"
    ;;
  update)
    update_geoffrey
    ;;
  update-check)
    shift
    update_check "$@"
    ;;
  schedule-updates)
    schedule_update_checks
    ;;
  install-launcher)
    install_launcher
    ;;
  install-desktop-button)
    install_desktop_button
    ;;
  launch)
    shift
    launch_geoffrey "$@"
    ;;
  chief-of-staff)
    shift
    chief_of_staff_setup "$@"
    ;;
  tools)
    shift
    tools_checklist "$@"
    ;;
  add-email)
    add_email
    ;;
  list-email)
    list_email
    ;;
  memory)
    shift
    memory_repo "$@"
    ;;
  packet)
    shift
    packet "$@"
    ;;
  share)
    shift
    share "$@"
    ;;
  doctor)
    doctor
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    say "Unknown command: $1"
    usage
    exit 1
    ;;
esac
